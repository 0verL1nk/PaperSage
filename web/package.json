{
  "name": "papersage-web",
  "private": true,
  "version": "1.15.0",
  "description": "AI research workspace for scholarly reading and writing.",
  "author": "PaperSage Contributors",
  "homepage": "https://github.com/0verL1nk/PaperSage",
  "repository": {
    "type": "git",
    "url": "https://github.com/0verL1nk/PaperSage.git"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test electron/updater.node.cjs electron/tray.node.cjs electron/gpu-pack.node.cjs electron/instance-lock.node.cjs electron/backend-shutdown.node.cjs scripts/verify-update-metadata.node.cjs && vitest run",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "desktop:dev": "node electron/dev.cjs",
    "desktop:backend": "node scripts/package-backend.cjs",
    "desktop:gpu-pack": "pnpm run build && node scripts/package-gpu-pack.cjs",
    "desktop:package": "pnpm run desktop:package:win",
    "desktop:package:win": "pnpm run build && pnpm run desktop:backend && electron-builder --win nsis --publish never",
    "desktop:package:mac": "pnpm run build && pnpm run desktop:backend && electron-builder --mac dmg --publish never",
    "desktop:package:linux": "pnpm run build && pnpm run desktop:backend && electron-builder --linux AppImage deb --publish never",
    "desktop:checksums": "node scripts/write-checksums.cjs",
    "desktop:verify-update-metadata": "node scripts/verify-update-metadata.cjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.40",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "latest",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "ai": "^7.0.37",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cmdk": "^1.1.1",
    "electron-updater": "6.8.9",
    "embla-carousel-react": "^8.6.0",
    "katex": "^0.18.1",
    "lucide-react": "latest",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-markdown": "latest",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.19.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "latest",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@tanstack/router-plugin": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tailwindcss": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.papersage.desktop",
    "productName": "PaperSage",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/**/*.node.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".desktop-backend",
        "to": "backend"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "0verL1nk",
        "repo": "PaperSage",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "PaperSage Contributors <0verL1nk@users.noreply.github.com>"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
